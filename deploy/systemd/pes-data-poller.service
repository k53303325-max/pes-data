[Unit]
Description=Pes Data Telegram poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pesdata
WorkingDirectory=/opt/pes-data
EnvironmentFile=/etc/pes-data-poller.env
ExecStart=/opt/pes-data/venv/bin/python scripts/telegram_poller.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
