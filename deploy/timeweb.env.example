# /etc/pes-data.env на Timeweb VPS (chmod 600)
PES_DATA_VPS=1
PES_DATA_POLLER=1

APP_URL=https://admin.example.ru

# Та же строка, что в ONREZA PostgreSQL (Kaiki). В пароле ! → %21
