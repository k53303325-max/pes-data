BOT_TOKEN=
TELEGRAM_BOT_DISABLED=1

ADMIN_ID=
ADMIN_USERNAME=
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_SECRET_KEY=

YOOKASSA_SHOP_ID=
