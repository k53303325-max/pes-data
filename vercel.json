{
  "version": 2,
  "git": {
    "deploymentEnabled": false
  },
  "github": {
    "enabled": false,
    "silent": true
  },
  "env": {
    "PROMO_TEST_CODE": "PESDATA100"
  },
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/public/static/$1" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  }
}
